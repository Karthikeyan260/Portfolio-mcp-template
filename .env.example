# Copy to .env for local stdio/dev use (wrangler dev reads .dev.vars instead — see below).
# Never commit real values.

# Required for AI tools (compare_job, ats_match, interview_questions, recommend_learning,
# portfolio_summary, experience_summary, generate_resume_summary). Without it, AI tools
# return a clear MCP error instead of crashing; all non-AI tools work fine without this.
GEMINI_API_KEY=

# Optional. Enables pinned repos + contribution calendar via GitHub GraphQL, and raises
# the REST rate limit for get_project's live repo metadata (stars/last push/languages).
# Needs no scopes beyond public_repo read access.
GITHUB_TOKEN=

# Optional. Used in a couple of generated links/prompts. Defaults to the value below.
SITE_URL=https://your-portfolio.example.com/
